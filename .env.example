# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# NVIDIA NIM (compatible con API OpenAI)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Google Sheets (Service Account)
# Contenido JSON completo del service account (en una sola linea) O ruta al archivo .json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1

# Zona horaria para el campo Fecha
TIMEZONE=America/Argentina/Buenos_Aires
